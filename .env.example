# =====================================================================
# Variables de entorno — Al Toque Raciones
# Copiá este archivo como .env.local para desarrollo local (vercel dev)
# y cargá las MISMAS variables en Vercel (Settings > Environment Variables).
# NUNCA subas el .env real al repositorio.
# =====================================================================

# --- Supabase (base de datos) ---
# Dashboard de Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clave service_role (SECRETA, solo servidor)

# --- MercadoPago ---
# Tus credenciales > Access Token. Para probar usá el de TEST; en producción el de PROD.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx

# --- WhatsApp Cloud API (Meta) ---
# Meta for Developers > tu app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAG...                     # token de acceso
WHATSAPP_PHONE_NUMBER_ID=123456789012345   # ID del número remitente (NO el número en sí)
OWNER_WHATSAPP=59898623158                 # número que RECIBE el aviso de pedido
# Opcional: si usás una plantilla aprobada en vez de texto libre
# WHATSAPP_TEMPLATE_NAME=nuevo_pedido
# WHATSAPP_TEMPLATE_LANG=es

# --- Admin ---
ADMIN_PASSWORD=cambia-esta-contraseña

# --- Sitio ---
# URL pública del sitio (para back_urls y webhook de MercadoPago).
# En local podés dejarla vacía; en Vercel poné https://altoqueraciones.com
SITE_URL=https://altoqueraciones.com
