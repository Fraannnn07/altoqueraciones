# =====================================================================
# Variables de entorno — Al Toque Raciones
# Copiar como .env.local para desarrollo (nunca commitear el real).
# Cargar las mismas en Vercel > Project Settings > Environment Variables.
# =====================================================================

# --- Supabase ---
# Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clave service_role (SECRETA, solo servidor)

# --- Admin (/admin) ---
# Contraseña del panel. En Vercel ya existe ADMIN_PASSWORD; localmente elegí una.
# Cambiarla cierra las sesiones abiertas.
ADMIN_PASSWORD=cambia-esta-contraseña

# --- Sitio ---
SITE_URL=https://altoqueraciones.com

# --- WhatsApp (botón "Comprar por WhatsApp") ---
OWNER_WHATSAPP=59898623158

# --- Google Ads conversion tracking (mismo ID/label que ya tenía la cuenta) ---
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18107703952
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=0iJNCPy-y58cEJDFtrpD

# --- Google Analytics 4 (en Vercel solo en Production, para no medir previews) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0QZP7H78HE

# --- Tarjeta de sellos (/fidelidad, ver docs/fidelidad/LEEME-fidelidad.md) ---
# URL que va dentro de los pases (QR, imágenes). Aparte de SITE_URL a propósito.
FIDELIDAD_SITE_URL=https://altoqueraciones.com
FIDELIDAD_ADMIN_PIN=                    # PIN del panel /fidelidad/admin/ (mínimo 6 caracteres)
FIDELIDAD_SELLOS_META=6
FIDELIDAD_PREMIO=10% de descuento en tu próxima bolsa
# WHATSAPP_NUMBER=                      # opcional; si falta usa OWNER_WHATSAPP

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_B64=                   # base64 del JSON de la cuenta de servicio, en una línea

# Apple Wallet (sin estas variables el botón de Apple no aparece)
APPLE_PASS_TYPE_ID=pass.com.altoqueraciones.sellos
APPLE_TEAM_ID=
APPLE_PASS_CERT_B64=                    # base64 de pass.pem
APPLE_PASS_KEY_B64=                     # base64 de pass.key
APPLE_PASS_KEY_PASSPHRASE=              # vacío si la clave no tiene contraseña
APPLE_WWDR_B64=                         # base64 de wwdr.pem
