# =====================================================================
# Variables de entorno — Al Toque Raciones
# Copiar como .env.local para desarrollo (nunca commitear el real).
# Cargar las mismas en Vercel > Project Settings > Environment Variables.
# =====================================================================

# --- Supabase ---
# Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # clave service_role (SECRETA, solo servidor)

# --- Admin (/admin) ---
# Contraseña del panel. En Vercel ya existe ADMIN_PASSWORD; localmente elegí una.
# Cambiarla cierra las sesiones abiertas.
ADMIN_PASSWORD=cambia-esta-contraseña

# --- Sitio ---
SITE_URL=https://altoqueraciones.com

# --- WhatsApp (botón "Comprar por WhatsApp") ---
OWNER_WHATSAPP=59898623158

# --- Google Ads conversion tracking (mismo ID/label que ya tenía la cuenta) ---
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18107703952
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=0iJNCPy-y58cEJDFtrpD
